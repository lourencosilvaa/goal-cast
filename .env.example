# ── Backend environment variables ────────────────────────────────────────────

# Supabase — use the SERVICE ROLE key on the backend (bypasses RLS safely)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Fernet encryption key for Gemini API keys stored in Supabase.
# Generate a new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Hugging Face — private model repository
# Token needs at least read access to the model repo
HF_TOKEN=
HF_REPO_ID=your-hf-username/football-prediction-model
# Local directory where the model will be cached (writable path on Render)
HF_LOCAL_DIR=/tmp/hf_models

# ── Results service ──────────────────────────────────────────────────────────
# Results (history + live) run inside the backend process — single image. Only
# the football-data.org key is needed, the same one the European fixtures
# pipeline uses. Without it the live chain has no provider and history still
# answers from the local corpus.
FOOTBALL_DATA_API_KEY=

# Only if results_gateway.mode is "http" (separately deployed results service):
# RESULTS_SERVICE_URL=http://127.0.0.1:8100
# RESULTS_SERVICE_API_KEY=

# ── Frontend environment variables (prefix VITE_) ────────────────────────────

# URL of the deployed backend service (set after Render deploy)
VITE_API_URL=https://football-prediction-agent-api.onrender.com

# Supabase — use the ANON (public) key on the frontend
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
