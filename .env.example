# ── Backend environment variables ────────────────────────────────────────────

# Supabase — use the SERVICE ROLE key on the backend (bypasses RLS safely)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Fernet encryption key for Gemini API keys stored in Supabase.
# Generate a new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Hugging Face — private model repository
# Token needs at least read access to the model repo
HF_TOKEN=
HF_REPO_ID=your-hf-username/football-prediction-model
# Local directory where the model will be cached (writable path on Render)
HF_LOCAL_DIR=/tmp/hf_models

# ── Results service ──────────────────────────────────────────────────────────
# The results track runs as its own Render service (Dockerfile.results). These
# variables are split across the two deployments on purpose.
#
# On BOTH services — the shared service-to-service secret. The results service
# refuses to start without it rather than serving a scraper and a metered API
# quota to anyone who finds its URL. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RESULTS_SERVICE_API_KEY=

# On the MAIN service only — where the results service lives. Render's internal
# URL in production; http://127.0.0.1:8100 when running both locally.
RESULTS_SERVICE_URL=http://127.0.0.1:8100

# On the RESULTS service only — football-data.org key, the same one the
# European fixtures pipeline uses. Without it the live chain falls through to
# the (disabled by default) Flashscore fallback and history still answers from
# the local corpus.
FOOTBALL_DATA_API_KEY=

# ── Frontend environment variables (prefix VITE_) ────────────────────────────

# URL of the deployed backend service (set after Render deploy)
VITE_API_URL=https://football-prediction-agent-api.onrender.com

# Supabase — use the ANON (public) key on the frontend
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
